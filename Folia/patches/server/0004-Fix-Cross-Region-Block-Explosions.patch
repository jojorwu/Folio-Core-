     }
+
+    // Folia start - Fix cross-region block explosions
+    private void explodeBlock(BlockPos blockPos, List<ServerExplosion.StackCollector> list) {
+        // CraftBukkit start - TNTPrimeEvent
+        BlockState state = this.level.getBlockState(blockPos);
+        Block block = state.getBlock();
+        if (this.level.getGameRules().getBoolean(GameRules.RULE_TNT_EXPLODES) && block instanceof net.minecraft.world.level.block.TntBlock) {
+            Entity sourceEntity = this.source == null ? null : this.source;
+            BlockPos sourceBlock = sourceEntity == null ? BlockPos.containing(this.center) : null;
+            if (!CraftEventFactory.callTNTPrimeEvent(this.level, blockPos, org.bukkit.event.block.TNTPrimeEvent.PrimeCause.EXPLOSION, sourceEntity, sourceBlock)) {
+                this.level.sendBlockUpdated(blockPos, net.minecraft.world.level.block.Blocks.AIR.defaultBlockState(), state, 3);
+                return;
+            }
+        }
+        // CraftBukkit end
+
+        this.level
+            .getBlockState(blockPos)
+            .onExplosionHit(this.level, blockPos, this, (itemStack, blockPos1) -> addOrAppendStack(list, itemStack, blockPos1));
+    }
+    // Folia end
 }
