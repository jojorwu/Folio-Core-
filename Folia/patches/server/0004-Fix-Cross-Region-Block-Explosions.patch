+            // Folia start - Fix cross-region block explosions
+            if (this.level.isOwnedByCurrentRegion(blockPos)) {
+                this.explodeBlock(blockPos, list);
+            } else {
+                this.level.getRegionScheduler().execute(blockPos, () -> this.explodeBlock(blockPos, list));
             }
-            // CraftBukkit end
-
-            this.level
-                .getBlockState(blockPos)
-                .onExplosionHit(this.level, blockPos, this, (itemStack, blockPos1) -> addOrAppendStack(list, itemStack, blockPos1));
