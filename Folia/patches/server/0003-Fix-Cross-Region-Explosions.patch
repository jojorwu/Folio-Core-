+            if (this.level.isOwnedByCurrentRegion(entity)) {
+                this.applyExplosionEffects(entity, f);
+            } else {
+                this.level.getRegionScheduler().execute(entity, () -> this.applyExplosionEffects(entity, f));
+            }
+        }
+    }

-                        double d4 = (1.0 - d) * f1 * knockbackMultiplier;
-                        double d5;
-                        if (entity instanceof LivingEntity livingEntity) {
-                            d5 = d4 * (1.0 - livingEntity.getAttributeValue(Attributes.EXPLOSION_KNOCKBACK_RESISTANCE));
